# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# WASM runtimes for the playground (Pyodide, sql.js) — copied from
# node_modules by scripts/copy-wasm-assets.mjs before dev/build
/public/wasm/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# ai agent instructions (auto-generated by `next dev`)
AGENTS.md
CLAUDE.md

# typescript
*.tsbuildinfo
next-env.d.ts
