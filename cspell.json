{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  "language": "en,en-GB",
  "ignorePaths": [
    ".git/**",
    ".husky/_/**",
    "node_modules/**",
    ".next/**",
    "public/**",
    "package-lock.json",
    "tsconfig.tsbuildinfo",
    ".vercel/**"
  ],
  "ignoreRegExpList": ["/<code>[\\s\\S]*?<\\/code>/g", "/<pre>[\\s\\S]*?<\\/pre>/g"],
  "dictionaryDefinitions": [
    {
      "name": "project",
      "path": "./.cspell/project-words.txt",
      "addWords": true
    }
  ],
  "dictionaries": [
    "project",
    "typescript",
    "node",
    "npm",
    "css",
    "html",
    "softwareTerms",
    "bash",
    "docker",
    "aws",
    "fullstack"
  ]
}
